{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "chalk.tsaur.com" }],
      "destination": "https://chalk.11i.sh/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "atlora.11i.sh" }],
      "destination": "/atlora/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
